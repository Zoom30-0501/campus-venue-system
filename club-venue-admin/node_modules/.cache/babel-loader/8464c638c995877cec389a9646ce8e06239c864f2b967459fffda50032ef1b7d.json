{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.json.parse.js\";\nimport \"core-js/modules/es.object.keys.js\";\nimport \"core-js/modules/es.string.starts-with.js\";\nexport default {\n  name: 'Layout',\n  data: function data() {\n    var user = JSON.parse(localStorage.getItem('user') || '{}');\n    return {\n      userNickname: user.nickname || user.username || '用户',\n      userAvatar: user.avatar || '',\n      role: localStorage.getItem('role') || 'user',\n      noticeCount: 3,\n      collapsed: false,\n      darkMode: (localStorage.getItem('theme') || 'light') === 'dark'\n    };\n  },\n  computed: {\n    activeMenu: function activeMenu() {\n      var path = this.$route.path;\n      if (path.startsWith('/club')) return '/club';\n      if (path.startsWith('/venue')) return '/venue';\n      if (path.startsWith('/activity')) return '/activity';\n      if (path.startsWith('/facility')) return '/facility';\n      if (path.startsWith('/user')) return '/user';\n      if (path.startsWith('/profile')) return '';\n      return path;\n    }\n  },\n  methods: {\n    toggleTheme: function toggleTheme() {\n      this.darkMode = !this.darkMode;\n      var theme = this.darkMode ? 'dark' : 'light';\n      localStorage.setItem('theme', theme);\n      document.documentElement.setAttribute('data-theme', theme);\n    },\n    handleCommand: function handleCommand(command) {\n      if (command === 'profile') {\n        this.$router.push('/profile');\n      } else if (command === 'toggleTheme') {\n        this.toggleTheme();\n      } else if (command === 'logout') {\n        localStorage.removeItem('user');\n        localStorage.removeItem('role');\n        this.$router.push('/login');\n        this.$message.success('已退出登录');\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","userNickname","nickname","username","userAvatar","avatar","role","noticeCount","collapsed","darkMode","computed","activeMenu","path","$route","startsWith","methods","toggleTheme","theme","setItem","document","documentElement","setAttribute","handleCommand","command","$router","push","removeItem","$message","success"],"sources":["src/views/Layout.vue"],"sourcesContent":["<template>\n  <el-container class=\"app-shell\">\n    <!-- Sidebar -->\n    <el-aside :width=\"collapsed ? '64px' : '220px'\" class=\"sidebar\">\n      <div class=\"logo\">\n        <div class=\"logo-dot\"></div>\n        <transition name=\"fade\">\n          <span v-show=\"!collapsed\" class=\"logo-text\">社团场地管理</span>\n        </transition>\n      </div>\n\n      <el-menu\n        router\n        :default-active=\"activeMenu\"\n        :collapse=\"collapsed\"\n        :collapse-transition=\"false\"\n        background-color=\"transparent\"\n        text-color=\"rgba(255,255,255,0.45)\"\n        active-text-color=\"#fff\"\n        class=\"side-menu\"\n      >\n        <el-menu-item index=\"/dashboard\">\n          <i class=\"el-icon-s-home\"></i>\n          <span>数据概览</span>\n        </el-menu-item>\n        <el-submenu index=\"business\">\n          <template slot=\"title\">\n            <i class=\"el-icon-s-operation\"></i>\n            <span>业务管理</span>\n          </template>\n          <el-menu-item index=\"/club\"><span>社团管理</span></el-menu-item>\n          <el-menu-item index=\"/venue\"><span>场地管理</span></el-menu-item>\n          <el-menu-item index=\"/activity\"><span>活动管理</span></el-menu-item>\n          <el-menu-item index=\"/facility\"><span>设施管理</span></el-menu-item>\n          <el-menu-item index=\"/venue-calendar\"><span>场地排期</span></el-menu-item>\n          <el-menu-item index=\"/suggestion\"><span>用户建议</span></el-menu-item>\n        </el-submenu>\n        <el-submenu v-if=\"role === 'admin'\" index=\"system\">\n          <template slot=\"title\">\n            <i class=\"el-icon-setting\"></i>\n            <span>系统管理</span>\n          </template>\n          <el-menu-item index=\"/user\"><span>用户管理</span></el-menu-item>\n        </el-submenu>\n      </el-menu>\n\n      <div class=\"collapse-btn\" @click=\"collapsed = !collapsed\">\n        <i :class=\"collapsed ? 'el-icon-s-unfold' : 'el-icon-s-fold'\"></i>\n      </div>\n    </el-aside>\n\n    <!-- Main -->\n    <el-container class=\"main-container\">\n      <!-- Header -->\n      <el-header class=\"header-bar\" height=\"52px\">\n        <div class=\"header-left\">\n          <span class=\"header-badge\">v2</span>\n          <span class=\"header-title\">高校社团活动场地管理系统</span>\n        </div>\n        <div class=\"header-right\">\n          <el-tooltip :content=\"darkMode ? '切换亮色' : '切换暗色'\" placement=\"bottom\">\n            <i :class=\"darkMode ? 'el-icon-sunny' : 'el-icon-moon'\" class=\"theme-toggle\" @click=\"toggleTheme\"></i>\n          </el-tooltip>\n\n          <!-- 通知已关闭 -->\n\n          <el-dropdown @command=\"handleCommand\" trigger=\"click\">\n            <span class=\"user-dropdown\">\n              <el-avatar :size=\"28\" :src=\"userAvatar\" class=\"user-avatar\">\n                <span>{{ userNickname ? userNickname.charAt(0) : '?' }}</span>\n              </el-avatar>\n              <span class=\"username\">{{ userNickname }}</span>\n              <i class=\"el-icon-arrow-down arrow-icon\"></i>\n            </span>\n            <el-dropdown-menu slot=\"dropdown\">\n              <el-dropdown-item command=\"profile\">个人中心</el-dropdown-item>\n              <el-dropdown-item command=\"toggleTheme\">\n                <i :class=\"darkMode ? 'el-icon-sunny' : 'el-icon-moon'\"></i>\n                {{ darkMode ? '切换亮色' : '切换暗色' }}\n              </el-dropdown-item>\n              <el-dropdown-item command=\"logout\" divided>退出登录</el-dropdown-item>\n            </el-dropdown-menu>\n          </el-dropdown>\n        </div>\n      </el-header>\n\n      <!-- Content -->\n      <el-main class=\"main-area\">\n        <div class=\"bg-grid\"></div>\n        <div class=\"content-wrapper\">\n          <router-view :key=\"$route.fullPath\" />\n        </div>\n      </el-main>\n    </el-container>\n  </el-container>\n</template>\n\n<script>\nexport default {\n  name: 'Layout',\n  data() {\n    const user = JSON.parse(localStorage.getItem('user') || '{}')\n    return {\n      userNickname: user.nickname || user.username || '用户',\n      userAvatar: user.avatar || '',\n      role: localStorage.getItem('role') || 'user',\n      noticeCount: 3,\n      collapsed: false,\n      darkMode: (localStorage.getItem('theme') || 'light') === 'dark'\n    }\n  },\n  computed: {\n    activeMenu() {\n      const path = this.$route.path\n      if (path.startsWith('/club')) return '/club'\n      if (path.startsWith('/venue')) return '/venue'\n      if (path.startsWith('/activity')) return '/activity'\n      if (path.startsWith('/facility')) return '/facility'\n      if (path.startsWith('/user')) return '/user'\n      if (path.startsWith('/profile')) return ''\n      return path\n    }\n  },\n  methods: {\n    toggleTheme() {\n      this.darkMode = !this.darkMode\n      const theme = this.darkMode ? 'dark' : 'light'\n      localStorage.setItem('theme', theme)\n      document.documentElement.setAttribute('data-theme', theme)\n    },\n    handleCommand(command) {\n      if (command === 'profile') {\n        this.$router.push('/profile')\n      } else if (command === 'toggleTheme') {\n        this.toggleTheme()\n      } else if (command === 'logout') {\n        localStorage.removeItem('user')\n        localStorage.removeItem('role')\n        this.$router.push('/login')\n        this.$message.success('已退出登录')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* === Shell === */\n.app-shell { height: 100%; }\n\n/* === Sidebar === */\n.sidebar {\n  background: linear-gradient(180deg, #0b0f1a 0%, #0d1225 100%);\n  display: flex;\n  flex-direction: column;\n  transition: width 0.28s cubic-bezier(0.4, 0, 0.2, 1);\n  overflow: hidden;\n  border-right: 1px solid rgba(255, 255, 255, 0.06);\n  position: relative;\n  z-index: 10;\n}\n\n.sidebar::before {\n  content: '';\n  position: absolute;\n  inset: 0;\n  background-image:\n    linear-gradient(rgba(255, 255, 255, 0.015) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(255, 255, 255, 0.015) 1px, transparent 1px);\n  background-size: 32px 32px;\n  pointer-events: none;\n  z-index: 0;\n}\n\n.logo {\n  height: 52px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 10px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.06);\n  flex-shrink: 0;\n  position: relative;\n  z-index: 1;\n}\n\n.logo-dot {\n  width: 9px;\n  height: 9px;\n  border-radius: 50%;\n  background: var(--brand-gradient);\n  box-shadow: 0 0 12px rgba(14, 165, 233, 0.5), 0 0 24px rgba(99, 102, 241, 0.3);\n  flex-shrink: 0;\n}\n\n.logo-text {\n  color: rgba(255, 255, 255, 0.85);\n  font-size: 14px;\n  font-weight: 600;\n  letter-spacing: 1px;\n  white-space: nowrap;\n}\n\n/* === Menu === */\n.side-menu {\n  border: none;\n  flex: 1;\n  overflow-y: auto;\n  overflow-x: hidden;\n  position: relative;\n  z-index: 1;\n}\n\n.side-menu >>> .el-menu-item,\n.side-menu >>> .el-submenu__title {\n  height: 40px;\n  line-height: 40px;\n  font-size: 13px;\n  margin: 2px 8px;\n  border-radius: 6px;\n  transition: all 0.2s ease;\n  position: relative;\n  overflow: hidden;\n}\n\n.side-menu >>> .el-menu-item:hover,\n.side-menu >>> .el-submenu__title:hover {\n  background: rgba(255, 255, 255, 0.05) !important;\n}\n\n.side-menu >>> .el-menu-item.is-active {\n  background: linear-gradient(135deg, rgba(14, 165, 233, 0.15), rgba(99, 102, 241, 0.1)) !important;\n  color: #fff !important;\n}\n\n.side-menu >>> .el-menu-item.is-active::before {\n  content: '';\n  position: absolute;\n  left: 0;\n  top: 50%;\n  transform: translateY(-50%);\n  width: 3px;\n  height: 18px;\n  border-radius: 0 2px 2px 0;\n  background: var(--brand-start);\n  box-shadow: 0 0 8px rgba(14, 165, 233, 0.5);\n}\n\n.side-menu >>> .el-submenu .el-menu {\n  background: rgba(0, 0, 0, 0.15) !important;\n}\n\n.side-menu >>> .el-submenu .el-menu-item {\n  padding-left: 56px !important;\n  font-size: 12px;\n  height: 36px;\n  line-height: 36px;\n}\n\n.side-menu >>> .el-submenu .el-menu-item:hover {\n  background: rgba(255, 255, 255, 0.04) !important;\n}\n\n.side-menu >>> .el-submenu .el-menu-item.is-active {\n  background: linear-gradient(135deg, rgba(14, 165, 233, 0.12), rgba(99, 102, 241, 0.08)) !important;\n}\n\n.side-menu.el-menu--collapse >>> .el-submenu__title span,\n.side-menu.el-menu--collapse >>> .el-submenu__title .el-submenu__icon-arrow {\n  display: none;\n}\n\n.side-menu.el-menu--collapse >>> .el-menu-item {\n  padding-left: 20px !important;\n}\n\n/* === Collapse Button === */\n.collapse-btn {\n  height: 40px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: rgba(255, 255, 255, 0.3);\n  cursor: pointer;\n  border-top: 1px solid rgba(255, 255, 255, 0.06);\n  transition: color 0.2s, background 0.2s;\n  flex-shrink: 0;\n  position: relative;\n  z-index: 1;\n}\n\n.collapse-btn:hover {\n  color: rgba(255, 255, 255, 0.7);\n  background: rgba(255, 255, 255, 0.03);\n}\n\n.collapse-btn i { font-size: 16px; }\n\n/* === Main Container === */\n.main-container { position: relative; }\n\n/* === Header === */\n.header-bar {\n  background: var(--header-bg);\n  backdrop-filter: saturate(180%) blur(12px);\n  -webkit-backdrop-filter: saturate(180%) blur(12px);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid var(--header-border);\n  padding: 0 20px;\n  position: relative;\n  z-index: 5;\n}\n\n.header-left {\n  display: flex;\n  align-items: center;\n  gap: 10px;\n}\n\n.header-badge {\n  font-size: 10px;\n  font-weight: 600;\n  color: #fff;\n  background: var(--brand-gradient);\n  padding: 1px 6px;\n  border-radius: 3px;\n  letter-spacing: 0.5px;\n  box-shadow: 0 1px 3px rgba(14, 165, 233, 0.3);\n}\n\n.header-title {\n  font-size: 13px;\n  font-weight: 500;\n  color: var(--text-secondary);\n  letter-spacing: 0.5px;\n}\n\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: 14px;\n}\n\n.theme-toggle {\n  font-size: 17px;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: color 0.2s, transform 0.3s;\n}\n\n.theme-toggle:hover {\n  color: var(--brand-start);\n  transform: rotate(15deg);\n}\n\n.notice-icon {\n  font-size: 17px;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: color 0.2s;\n}\n\n.notice-icon:hover { color: var(--brand-start); }\n\n.user-dropdown {\n  display: flex;\n  align-items: center;\n  gap: 7px;\n  cursor: pointer;\n  padding: 4px 10px;\n  border-radius: 6px;\n  transition: background 0.15s;\n}\n\n.user-dropdown:hover {\n  background: rgba(0, 0, 0, 0.04);\n}\n\n[data-theme=\"dark\"] .user-dropdown:hover {\n  background: rgba(255, 255, 255, 0.04);\n}\n\n.user-avatar { flex-shrink: 0; }\n\n.username {\n  font-size: 12px;\n  color: var(--text-secondary);\n  font-weight: 500;\n}\n\n.arrow-icon {\n  font-size: 11px;\n  color: var(--text-muted);\n}\n\n/* === Content === */\n.main-area {\n  background: var(--content-bg);\n  padding: 16px;\n  position: relative;\n  overflow: auto;\n}\n\n.bg-grid {\n  position: absolute;\n  inset: 0;\n  background-image:\n    linear-gradient(rgba(14, 165, 233, 0.015) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(14, 165, 233, 0.015) 1px, transparent 1px);\n  background-size: 48px 48px;\n  pointer-events: none;\n  z-index: 0;\n}\n\n[data-theme=\"dark\"] .bg-grid {\n  background-image:\n    linear-gradient(rgba(14, 165, 233, 0.025) 1px, transparent 1px),\n    linear-gradient(90deg, rgba(14, 165, 233, 0.025) 1px, transparent 1px);\n}\n\n.content-wrapper {\n  position: relative;\n  z-index: 1;\n}\n</style>\n"],"mappings":";;;;AAkGA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA,IAAAC,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;MACAC,YAAA,EAAAL,IAAA,CAAAM,QAAA,IAAAN,IAAA,CAAAO,QAAA;MACAC,UAAA,EAAAR,IAAA,CAAAS,MAAA;MACAC,IAAA,EAAAP,YAAA,CAAAC,OAAA;MACAO,WAAA;MACAC,SAAA;MACAC,QAAA,GAAAV,YAAA,CAAAC,OAAA;IACA;EACA;EACAU,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,IAAAC,IAAA,QAAAC,MAAA,CAAAD,IAAA;MACA,IAAAA,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,OAAAF,IAAA;IACA;EACA;EACAG,OAAA;IACAC,WAAA,WAAAA,YAAA;MACA,KAAAP,QAAA,SAAAA,QAAA;MACA,IAAAQ,KAAA,QAAAR,QAAA;MACAV,YAAA,CAAAmB,OAAA,UAAAD,KAAA;MACAE,QAAA,CAAAC,eAAA,CAAAC,YAAA,eAAAJ,KAAA;IACA;IACAK,aAAA,WAAAA,cAAAC,OAAA;MACA,IAAAA,OAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,WAAAF,OAAA;QACA,KAAAP,WAAA;MACA,WAAAO,OAAA;QACAxB,YAAA,CAAA2B,UAAA;QACA3B,YAAA,CAAA2B,UAAA;QACA,KAAAF,OAAA,CAAAC,IAAA;QACA,KAAAE,QAAA,CAAAC,OAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}