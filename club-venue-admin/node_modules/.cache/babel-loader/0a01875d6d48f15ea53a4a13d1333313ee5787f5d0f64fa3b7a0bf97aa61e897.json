{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.json.parse.js\";\nimport \"core-js/modules/es.object.keys.js\";\nimport \"core-js/modules/es.string.starts-with.js\";\nexport default {\n  name: 'Layout',\n  data: function data() {\n    var user = JSON.parse(localStorage.getItem('user') || '{}');\n    return {\n      userNickname: user.nickname || user.username || '用户',\n      userAvatar: user.avatar || '',\n      role: localStorage.getItem('role') || 'user',\n      noticeCount: 3\n    };\n  },\n  computed: {\n    activeMenu: function activeMenu() {\n      var path = this.$route.path;\n      if (path.startsWith('/club')) return '/club';\n      if (path.startsWith('/venue')) return '/venue';\n      if (path.startsWith('/activity')) return '/activity';\n      if (path.startsWith('/user')) return '/user';\n      if (path.startsWith('/profile')) return '';\n      return path;\n    }\n  },\n  methods: {\n    handleCommand: function handleCommand(command) {\n      if (command === 'profile') {\n        this.$router.push('/profile');\n      } else if (command === 'logout') {\n        localStorage.removeItem('user');\n        this.$router.push('/login');\n        this.$message.success('已退出登录');\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","userNickname","nickname","username","userAvatar","avatar","role","noticeCount","computed","activeMenu","path","$route","startsWith","methods","handleCommand","command","$router","push","removeItem","$message","success"],"sources":["src/views/Layout.vue"],"sourcesContent":["<template>\n  <el-container style=\"height:100%\">\n    <el-aside width=\"200px\" class=\"sidebar\">\n      <div class=\"logo\">社团场地管理</div>\n      <el-menu\n        router\n        :default-active=\"activeMenu\"\n        background-color=\"transparent\"\n        text-color=\"rgba(255,255,255,0.65)\"\n        active-text-color=\"#fff\"\n        class=\"side-menu\"\n      >\n        <el-menu-item index=\"/dashboard\">\n          <i class=\"el-icon-s-home\"></i>\n          <span>数据概览</span>\n        </el-menu-item>\n        <el-submenu index=\"business\">\n          <template slot=\"title\">\n            <i class=\"el-icon-s-operation\"></i>\n            <span>业务管理</span>\n          </template>\n          <el-menu-item index=\"/club\">社团管理</el-menu-item>\n          <el-menu-item index=\"/venue\">场地管理</el-menu-item>\n          <el-menu-item index=\"/activity\">活动管理</el-menu-item>\n          <el-menu-item index=\"/facility\">设施管理</el-menu-item>\n        </el-submenu>\n        <el-submenu v-if=\"role === 'admin'\" index=\"system\">\n          <template slot=\"title\">\n            <i class=\"el-icon-setting\"></i>\n            <span>系统管理</span>\n          </template>\n          <el-menu-item index=\"/user\">用户管理</el-menu-item>\n        </el-submenu>\n      </el-menu>\n    </el-aside>\n\n    <el-container>\n      <el-header class=\"header-bar\">\n        <div class=\"header-left\">高校社团活动场地管理系统</div>\n        <div class=\"header-right\">\n          <el-badge :value=\"noticeCount\" :hidden=\"noticeCount === 0\" class=\"notice-badge\">\n            <i class=\"el-icon-bell notice-icon\"></i>\n          </el-badge>\n          <el-dropdown @command=\"handleCommand\" trigger=\"click\">\n            <span class=\"user-dropdown\">\n              <el-avatar :size=\"28\" :src=\"userAvatar\">\n                <span>{{ userNickname ? userNickname.charAt(0) : '?' }}</span>\n              </el-avatar>\n              <span class=\"username\">{{ userNickname }}</span>\n              <i class=\"el-icon-arrow-down arrow-icon\"></i>\n            </span>\n            <el-dropdown-menu slot=\"dropdown\">\n              <el-dropdown-item command=\"profile\">个人中心</el-dropdown-item>\n              <el-dropdown-item command=\"logout\" divided>退出登录</el-dropdown-item>\n            </el-dropdown-menu>\n          </el-dropdown>\n        </div>\n      </el-header>\n      <el-main class=\"main-area\">\n        <router-view />\n      </el-main>\n    </el-container>\n  </el-container>\n</template>\n\n<script>\nexport default {\n  name: 'Layout',\n  data() {\n    const user = JSON.parse(localStorage.getItem('user') || '{}')\n    return {\n      userNickname: user.nickname || user.username || '用户',\n      userAvatar: user.avatar || '',\n      role: localStorage.getItem('role') || 'user',\n      noticeCount: 3\n    }\n  },\n  computed: {\n    activeMenu() {\n      const path = this.$route.path\n      if (path.startsWith('/club')) return '/club'\n      if (path.startsWith('/venue')) return '/venue'\n      if (path.startsWith('/activity')) return '/activity'\n      if (path.startsWith('/user')) return '/user'\n      if (path.startsWith('/profile')) return ''\n      return path\n    }\n  },\n  methods: {\n    handleCommand(command) {\n      if (command === 'profile') {\n        this.$router.push('/profile')\n      } else if (command === 'logout') {\n        localStorage.removeItem('user')\n        this.$router.push('/login')\n        this.$message.success('已退出登录')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* 侧边栏 */\n.sidebar {\n  background: #2C3E50;\n}\n\n.logo {\n  height: 56px;\n  line-height: 56px;\n  text-align: center;\n  color: rgba(255, 255, 255, 0.9);\n  font-size: 15px;\n  font-weight: 600;\n  letter-spacing: 1px;\n  border-bottom: 1px solid rgba(255, 255, 255, 0.08);\n}\n\n.side-menu {\n  border: none;\n}\n\n.side-menu .el-menu-item,\n.side-menu .el-submenu__title {\n  height: 44px;\n  line-height: 44px;\n  font-size: 13px;\n}\n\n.side-menu .el-menu-item:hover,\n.side-menu .el-submenu__title:hover {\n  background: rgba(255, 255, 255, 0.06) !important;\n}\n\n.side-menu .el-menu-item.is-active {\n  background: #00BFFF !important;\n}\n\n/* 顶部栏 */\n.header-bar {\n  background: #fff;\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid #E4E7ED;\n  padding: 0 24px;\n  height: 52px !important;\n}\n\n.header-left {\n  font-size: 15px;\n  font-weight: 600;\n  color: #303133;\n  letter-spacing: 1px;\n}\n\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: 20px;\n}\n\n.notice-icon {\n  font-size: 18px;\n  color: #909399;\n  cursor: pointer;\n  transition: color 0.2s;\n}\n\n.notice-icon:hover {\n  color: #00BFFF;\n}\n\n.user-dropdown {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  cursor: pointer;\n  padding: 4px 8px;\n  border-radius: 2px;\n  transition: background 0.2s;\n}\n\n.user-dropdown:hover {\n  background: #F5F7FA;\n}\n\n.username {\n  font-size: 13px;\n  color: #606266;\n}\n\n.arrow-icon {\n  font-size: 12px;\n  color: #C0C4CC;\n}\n\n/* 主区域 */\n.main-area {\n  background: #F5F7FA;\n  padding: 16px;\n}\n</style>\n"],"mappings":";;;;AAkEA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA,IAAAC,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;MACAC,YAAA,EAAAL,IAAA,CAAAM,QAAA,IAAAN,IAAA,CAAAO,QAAA;MACAC,UAAA,EAAAR,IAAA,CAAAS,MAAA;MACAC,IAAA,EAAAP,YAAA,CAAAC,OAAA;MACAO,WAAA;IACA;EACA;EACAC,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,IAAAC,IAAA,QAAAC,MAAA,CAAAD,IAAA;MACA,IAAAA,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,OAAAF,IAAA;IACA;EACA;EACAG,OAAA;IACAC,aAAA,WAAAA,cAAAC,OAAA;MACA,IAAAA,OAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,WAAAF,OAAA;QACAhB,YAAA,CAAAmB,UAAA;QACA,KAAAF,OAAA,CAAAC,IAAA;QACA,KAAAE,QAAA,CAAAC,OAAA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}