{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nexport default {\n  name: 'Login',\n  data: function data() {\n    return {\n      loginForm: {\n        username: '',\n        password: ''\n      },\n      showPassword: false,\n      loginRules: {\n        username: [{\n          required: true,\n          message: '请输入用户名',\n          trigger: 'blur'\n        }],\n        password: [{\n          required: true,\n          message: '请输入密码',\n          trigger: 'blur'\n        }]\n      }\n    };\n  },\n  methods: {\n    handleLogin: function handleLogin() {\n      var _this = this;\n      this.$refs.loginForm.validate(function (valid) {\n        if (valid) {\n          // TODO: 调用登录接口\n          _this.$router.push('/');\n        }\n      });\n    }\n  }\n};","map":{"version":3,"names":["name","data","loginForm","username","password","showPassword","loginRules","required","message","trigger","methods","handleLogin","_this","$refs","validate","valid","$router","push"],"sources":["src/views/Login.vue"],"sourcesContent":["<template>\n  <div class=\"login-bg\">\n    <div class=\"login-container\">\n      <div class=\"login-card\">\n        <h1 class=\"title\">高校活动场地管理系统</h1>\n        <el-form ref=\"loginForm\" :model=\"loginForm\" :rules=\"loginRules\" class=\"login-form\">\n          <el-form-item prop=\"username\" class=\"form-item\">\n            <div class=\"input-wrapper\">\n              <i class=\"el-icon-user input-icon\"></i>\n              <input\n                v-model=\"loginForm.username\"\n                placeholder=\"用户名\"\n                class=\"custom-input\"\n              />\n            </div>\n          </el-form-item>\n          <el-form-item prop=\"password\" class=\"form-item\">\n            <div class=\"input-wrapper\">\n              <i class=\"el-icon-lock input-icon\"></i>\n              <input\n                v-model=\"loginForm.password\"\n                :type=\"showPassword ? 'text' : 'password'\"\n                placeholder=\"密码\"\n                class=\"custom-input\"\n              />\n              <i\n                class=\"el-icon-view eye-icon\"\n                @click=\"showPassword = !showPassword\"\n              ></i>\n            </div>\n          </el-form-item>\n          <el-form-item class=\"form-item\">\n            <button class=\"login-btn\" @click.prevent=\"handleLogin\">登录</button>\n          </el-form-item>\n        </el-form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      loginForm: { username: '', password: '' },\n      showPassword: false,\n      loginRules: {\n        username: [{ required: true, message: '请输入用户名', trigger: 'blur' }],\n        password: [{ required: true, message: '请输入密码', trigger: 'blur' }]\n      }\n    }\n  },\n  methods: {\n    handleLogin() {\n      this.$refs.loginForm.validate(valid => {\n        if (valid) {\n          // TODO: 调用登录接口\n          this.$router.push('/')\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n* {\n  box-sizing: border-box;\n}\n\n.login-bg {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: linear-gradient(135deg, #E8F4FD 0%, #F0F4F8 40%, #F8F9FA 100%);\n}\n\n.login-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100%;\n  padding: 0 40px;\n}\n\n.login-card {\n  width: 100%;\n  max-width: 460px;\n  background: #FFFFFF;\n  border-radius: 16px;\n  padding: 48px 40px 40px;\n  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.08);\n}\n\n.title {\n  text-align: center;\n  font-size: 24px;\n  font-weight: 700;\n  color: #1A1A2E;\n  margin: 0 0 40px 0;\n  letter-spacing: 2px;\n}\n\n.login-form {\n  width: 100%;\n}\n\n.form-item {\n  margin-bottom: 16px;\n}\n\n.input-wrapper {\n  display: flex;\n  align-items: center;\n  background: #F5F6FA;\n  border-radius: 12px;\n  height: 52px;\n  padding: 0 18px;\n  border: 1px solid #EBEDF2;\n  transition: border-color 0.2s, background 0.2s;\n}\n\n.input-wrapper:focus-within {\n  border-color: #5B9BD5;\n  background: #EDF4FB;\n}\n\n.input-icon {\n  color: #B0B8C8;\n  font-size: 18px;\n  margin-right: 12px;\n  flex-shrink: 0;\n}\n\n.custom-input {\n  flex: 1;\n  height: 100%;\n  border: none;\n  outline: none;\n  background: transparent;\n  color: #2C3E50;\n  font-size: 15px;\n}\n\n.custom-input::placeholder {\n  color: #BFC6D0;\n}\n\n.eye-icon {\n  color: #B0B8C8;\n  font-size: 18px;\n  cursor: pointer;\n  flex-shrink: 0;\n  margin-left: 12px;\n}\n\n.eye-icon:hover {\n  color: #6C7A8D;\n}\n\n.login-btn {\n  width: 100%;\n  height: 52px;\n  border: none;\n  outline: none;\n  background: #00D97E;\n  color: #FFFFFF;\n  font-size: 17px;\n  font-weight: 600;\n  border-radius: 12px;\n  cursor: pointer;\n  letter-spacing: 4px;\n  margin-top: 8px;\n  transition: background 0.2s, transform 0.1s;\n}\n\n.login-btn:hover {\n  background: #00C570;\n}\n\n.login-btn:active {\n  transform: scale(0.98);\n}\n</style>\n"],"mappings":";AAyCA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,SAAA;QAAAC,QAAA;QAAAC,QAAA;MAAA;MACAC,YAAA;MACAC,UAAA;QACAH,QAAA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAL,QAAA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;IACA;EACA;EACAC,OAAA;IACAC,WAAA,WAAAA,YAAA;MAAA,IAAAC,KAAA;MACA,KAAAC,KAAA,CAAAX,SAAA,CAAAY,QAAA,WAAAC,KAAA;QACA,IAAAA,KAAA;UACA;UACAH,KAAA,CAAAI,OAAA,CAAAC,IAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}