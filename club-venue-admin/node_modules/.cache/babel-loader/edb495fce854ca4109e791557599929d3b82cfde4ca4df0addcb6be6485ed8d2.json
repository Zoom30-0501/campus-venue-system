{"ast":null,"code":"export default {\n  name: 'App',\n  created: function created() {\n    // 仅浅色模式\n    document.documentElement.setAttribute('data-theme', 'light');\n  },\n  mounted: function mounted() {\n    // 监听主题变化（从 Layout 触发）\n    var observer = new MutationObserver(function () {\n      var current = document.documentElement.getAttribute('data-theme');\n      localStorage.setItem('theme', current || 'light');\n    });\n    observer.observe(document.documentElement, {\n      attributes: true,\n      attributeFilter: ['data-theme']\n    });\n  }\n};","map":{"version":3,"names":["name","created","document","documentElement","setAttribute","mounted","observer","MutationObserver","current","getAttribute","localStorage","setItem","observe","attributes","attributeFilter"],"sources":["src/App.vue"],"sourcesContent":["<template>\n  <div id=\"app\">\n    <router-view />\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'App',\n  created() {\n    // 仅浅色模式\n    document.documentElement.setAttribute('data-theme', 'light')\n  },\n  mounted() {\n    // 监听主题变化（从 Layout 触发）\n    const observer = new MutationObserver(() => {\n      const current = document.documentElement.getAttribute('data-theme')\n      localStorage.setItem('theme', current || 'light')\n    })\n    observer.observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] })\n  }\n}\n</script>\n\n<style>\n@import './theme.css';\n\n* {\n  margin: 0;\n  padding: 0;\n  box-sizing: border-box;\n}\nhtml, body, #app {\n  height: 100%;\n  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', 'PingFang SC', 'Microsoft YaHei', sans-serif;\n  color: var(--text-primary);\n  background: var(--content-bg);\n  -webkit-font-smoothing: antialiased;\n}\n</style>\n"],"mappings":"AAOA;EACAA,IAAA;EACAC,OAAA,WAAAA,QAAA;IACA;IACAC,QAAA,CAAAC,eAAA,CAAAC,YAAA;EACA;EACAC,OAAA,WAAAA,QAAA;IACA;IACA,IAAAC,QAAA,OAAAC,gBAAA;MACA,IAAAC,OAAA,GAAAN,QAAA,CAAAC,eAAA,CAAAM,YAAA;MACAC,YAAA,CAAAC,OAAA,UAAAH,OAAA;IACA;IACAF,QAAA,CAAAM,OAAA,CAAAV,QAAA,CAAAC,eAAA;MAAAU,UAAA;MAAAC,eAAA;IAAA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}