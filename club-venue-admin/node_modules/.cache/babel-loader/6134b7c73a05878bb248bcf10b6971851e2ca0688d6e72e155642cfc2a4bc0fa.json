\n        </el-form-item>\n        <el-form-item prop=\"nickname\">\n          <el-input v-model=\"form.nickname\" size=\"small\" placeholder=\"昵称\" prefix-icon=\"el-icon-edit-outline\" />\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" size=\"small\" class=\"register-btn\" @click=\"submit\" :loading=\"loading\">注 册</el-button>\n        </el-form-item>\n        <div class=\"link-login\">\n          已有账号？<router-link to=\"/login\">去登录</router-link>\n        </div>\n      </el-form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport request from '@/api'\n\nexport default {\n  name: 'Register',\n  data() {\n    return {\n      form: { username: '', password: '', nickname: '' },\n      rules: {\n        username: [{ required: true, message: '请输入用户名', trigger: 'blur' }],\n        password: [\n          { required: true, message: '请输入密码', trigger: 'blur' },\n          { min: 6, message: '密码至少6位', trigger: 'blur' }\n        ],\n        nickname: [{ required: true, message: '请输入昵称', trigger: 'blur' }]\n      },\n      loading: false\n    }\n  },\n  methods: {\n    async submit() {\n      try { await this.$refs.form.validate() } catch { return }\n      this.loading = true\n      try {\n        const res = await request.post('/user/register', this.form)\n        if (res.code === 200) { this.$message.success('注册成功，请登录'); this.$router.push('/login') }\n        else { this.$message.error(res.message || '注册失败') }\n      } catch { this.$message.error('注册失败') }\n      finally { this.loading = false }\n    },\n  }\n}\n</script>\n\n<style scoped>\n.register-page {\n  height: 100vh; display: flex; align-items: center; justify-content: center;\n  background: linear-gradient(135deg, #f5f3ff 0%, #f0f9ff 50%, #f8fafc 100%);\n  position: relative; overflow: hidden;\n}\n/* 装饰旋转块 */\n.deco-block { position: absolute; border-radius: 30px; opacity: 0.2; z-index: 0; }\n.deco-block.d1 { width: 360px; height: 360px; background: linear-gradient(135deg, rgba(14,165,233,0.35), rgba(99,102,241,0.15)); top: -100px; right: -100px; transform: rotate(15deg); animation: spin1 20s linear infinite; }\n.deco-block.d2 { width: 250px; height: 250px; background: linear-gradient(225deg, rgba(245,158,11,0.25), rgba(239,68,68,0.1)); bottom: -60px; left: -60px; transform: rotate(-10deg); animation: spin2 25s linear infinite; }\n@keyframes spin1 { from { transform: rotate(0deg) } to { transform: rotate(360deg) } }\n@keyframes spin2 { from { transform: rotate(0deg) } to { transform: rotate(-360deg) } }\n\n.register-card {\n  position: relative; z-index: 1; width: 380px;\n  background: rgba(255,255,255,0.9); backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(0,0,0,0.06); border-radius: 12px; padding: 36px 32px 28px;\n  box-shadow: 0 20px 60px rgba(0,0,0,0.08);\n}\n.register-header { text-align: center; margin-bottom: 28px; }\n.card-dot { width: 10px; height: 10px; border-radius: 50%; background: linear-gradient(135deg, #0ea5e9, #6366f1); margin: 0 auto 14px; box-shadow: 0 0 16px rgba(14,165,233,0.5); }\n.card-title { font-size: 22px; font-weight: 700; color: #1e293b; letter-spacing: 1px; margin-bottom: 6px; }\n.card-sub { font-size: 12px; color: #64748b; letter-spacing: 0.5px; }\n.register-card >>> .el-input__inner { background: #f8fafc !important; border: 1px solid #e2e8f0 !important; color: #1e293b !important; border-radius: 6px; height: 40px; }\n.register-card >>> .el-input__inner::placeholder { color: #94a3b8 !important; }\n.register-card >>> .el-input__inner:focus { border-color: #6366f1 !important; box-shadow: 0 0 0 2px rgba(99,102,241,0.15) !important; }\n.register-card >>> .el-input__prefix i { color: #94a3b8; }\n.register-btn { width: 100%; height: 40px; font-size: 14px; letter-spacing: 4px; border-radius: 6px; }\n.link-login { text-align: center; font-size: 12px; color: #94a3b8; margin-top: 8px; }\n.link-login a { color: #6366f1; text-decoration: none; transition: opacity .2s; }\n.link-login a:hover { opacity: 0.8; }\n</style>\n"],"mappings":";;;AAkCA,OAAAA,OAAA;AAEA;EACAC,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,IAAA;QAAAC,QAAA;QAAAC,QAAA;QAAAC,QAAA;MAAA;MACAC,KAAA;QACAH,QAAA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAL,QAAA,GACA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA,GACA;UAAAC,GAAA;UAAAF,OAAA;UAAAC,OAAA;QAAA,EACA;QACAJ,QAAA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;MACAE,OAAA;IACA;EACA;EACAC,OAAA;IACAC,MAAA,WAAAA,OAAA;MAAA,IAAAC,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA,EAAAC,EAAA,EAAAC,GAAA;QAAA,OAAAL,YAAA,GAAAM,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OACAX,KAAA,CAAAY,KAAA,CAAAxB,IAAA,CAAAyB,QAAA;YAAA;cAAAJ,QAAA,CAAAE,CAAA;cAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAJ,EAAA,GAAAG,QAAA,CAAAK,CAAA;cAAA,OAAAL,QAAA,CAAAM,CAAA;YAAA;cACAf,KAAA,CAAAH,OAAA;cAAAY,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEA1B,OAAA,CAAA+B,IAAA,mBAAAhB,KAAA,CAAAZ,IAAA;YAAA;cAAAiB,GAAA,GAAAI,QAAA,CAAAK,CAAA;cACA,IAAAT,GAAA,CAAAY,IAAA;gBAAAjB,KAAA,CAAAkB,QAAA,CAAAC,OAAA;gBAAAnB,KAAA,CAAAoB,OAAA,CAAAC,IAAA;cAAA,OACA;gBAAArB,KAAA,CAAAkB,QAAA,CAAAI,KAAA,CAAAjB,GAAA,CAAAX,OAAA;cAAA;cAAAe,QAAA,CAAAE,CAAA;cAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAH,GAAA,GAAAE,QAAA,CAAAK,CAAA;cACAd,KAAA,CAAAkB,QAAA,CAAAI,KAAA;YAAA;cAAAb,QAAA,CAAAC,CAAA;cACAV,KAAA,CAAAH,OAAA;cAAA,OAAAY,QAAA,CAAAc,CAAA;YAAA;cAAA,OAAAd,QAAA,CAAAM,CAAA;UAAA;QAAA,GAAAX,OAAA;MAAA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}