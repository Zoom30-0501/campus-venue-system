{"ast":null,"code":"import \"core-js/modules/es.array.push.js\";\nimport \"core-js/modules/es.json.parse.js\";\nimport \"core-js/modules/es.object.keys.js\";\nimport \"core-js/modules/es.string.starts-with.js\";\nexport default {\n  name: 'Layout',\n  data: function data() {\n    var user = JSON.parse(localStorage.getItem('user') || '{}');\n    return {\n      userNickname: user.nickname || user.username || '用户',\n      userAvatar: user.avatar || '',\n      role: localStorage.getItem('role') || 'user',\n      noticeCount: 3,\n      collapsed: false,\n      darkMode: (localStorage.getItem('theme') || 'light') === 'dark'\n    };\n  },\n  computed: {\n    activeMenu: function activeMenu() {\n      var path = this.$route.path;\n      if (path.startsWith('/club')) return '/club';\n      if (path.startsWith('/venue')) return '/venue';\n      if (path.startsWith('/activity')) return '/activity';\n      if (path.startsWith('/facility')) return '/facility';\n      if (path.startsWith('/user')) return '/user';\n      if (path.startsWith('/profile')) return '';\n      return path;\n    }\n  },\n  methods: {\n    toggleTheme: function toggleTheme() {\n      this.darkMode = !this.darkMode;\n      var theme = this.darkMode ? 'dark' : 'light';\n      localStorage.setItem('theme', theme);\n      document.documentElement.setAttribute('data-theme', theme);\n    },\n    handleCommand: function handleCommand(command) {\n      if (command === 'profile') {\n        this.$router.push('/profile');\n      } else if (command === 'toggleTheme') {\n        this.toggleTheme();\n      } else if (command === 'logout') {\n        localStorage.removeItem('user');\n        localStorage.removeItem('role');\n        this.$router.push('/login');\n        this.$message.success('已退出登录');\n      }\n    }\n  }\n};","map":{"version":3,"names":["name","data","user","JSON","parse","localStorage","getItem","userNickname","nickname","username","userAvatar","avatar","role","noticeCount","collapsed","darkMode","computed","activeMenu","path","$route","startsWith","methods","toggleTheme","theme","setItem","document","documentElement","setAttribute","handleCommand","command","$router","push","removeItem","$message","success"],"sources":["src/views/Layout.vue"],"sourcesContent":["<template>\n  <el-container style=\"height:100%\">\n    <!-- Sidebar -->\n    <el-aside :width=\"collapsed ? '64px' : '220px'\" class=\"sidebar\">\n      <!-- Logo -->\n      <div class=\"logo\">\n        <div class=\"logo-dot\"></div>\n        <transition name=\"fade\">\n          <span v-show=\"!collapsed\" class=\"logo-text\">社团场地管理</span>\n        </transition>\n      </div>\n\n      <!-- Menu -->\n      <el-menu\n        router\n        :default-active=\"activeMenu\"\n        :collapse=\"collapsed\"\n        :collapse-transition=\"false\"\n        background-color=\"transparent\"\n        text-color=\"rgba(255,255,255,0.55)\"\n        active-text-color=\"#fff\"\n        class=\"side-menu\"\n      >\n        <el-menu-item index=\"/dashboard\">\n          <i class=\"el-icon-s-home\"></i>\n          <span>数据概览</span>\n        </el-menu-item>\n        <el-submenu index=\"business\">\n          <template slot=\"title\">\n            <i class=\"el-icon-s-operation\"></i>\n            <span>业务管理</span>\n          </template>\n          <el-menu-item index=\"/club\">\n            <span>社团管理</span>\n          </el-menu-item>\n          <el-menu-item index=\"/venue\">\n            <span>场地管理</span>\n          </el-menu-item>\n          <el-menu-item index=\"/activity\">\n            <span>活动管理</span>\n          </el-menu-item>\n          <el-menu-item index=\"/facility\">\n            <span>设施管理</span>\n          </el-menu-item>\n        </el-submenu>\n        <el-submenu v-if=\"role === 'admin'\" index=\"system\">\n          <template slot=\"title\">\n            <i class=\"el-icon-setting\"></i>\n            <span>系统管理</span>\n          </template>\n          <el-menu-item index=\"/user\">\n            <span>用户管理</span>\n          </el-menu-item>\n        </el-submenu>\n      </el-menu>\n\n      <!-- Collapse Toggle -->\n      <div class=\"collapse-btn\" @click=\"collapsed = !collapsed\">\n        <i :class=\"collapsed ? 'el-icon-s-unfold' : 'el-icon-s-fold'\"></i>\n      </div>\n    </el-aside>\n\n    <!-- Main -->\n    <el-container>\n      <!-- Header -->\n      <el-header class=\"header-bar\" height=\"48px\">\n        <div class=\"header-left\">高校社团活动场地管理系统</div>\n        <div class=\"header-right\">\n          <!-- Dark Mode Toggle -->\n          <el-tooltip :content=\"darkMode ? '切换亮色' : '切换暗色'\" placement=\"bottom\">\n            <i :class=\"darkMode ? 'el-icon-sunny' : 'el-icon-moon'\" class=\"theme-toggle\" @click=\"toggleTheme\"></i>\n          </el-tooltip>\n\n          <el-badge :value=\"noticeCount\" :hidden=\"noticeCount === 0\" class=\"notice-badge\">\n            <i class=\"el-icon-bell notice-icon\"></i>\n          </el-badge>\n\n          <el-dropdown @command=\"handleCommand\" trigger=\"click\">\n            <span class=\"user-dropdown\">\n              <el-avatar :size=\"28\" :src=\"userAvatar\">\n                <span>{{ userNickname ? userNickname.charAt(0) : '?' }}</span>\n              </el-avatar>\n              <span class=\"username\">{{ userNickname }}</span>\n              <i class=\"el-icon-arrow-down arrow-icon\"></i>\n            </span>\n            <el-dropdown-menu slot=\"dropdown\">\n              <el-dropdown-item command=\"profile\">个人中心</el-dropdown-item>\n              <el-dropdown-item command=\"toggleTheme\">\n                <i :class=\"darkMode ? 'el-icon-sunny' : 'el-icon-moon'\"></i>\n                {{ darkMode ? '切换亮色' : '切换暗色' }}\n              </el-dropdown-item>\n              <el-dropdown-item command=\"logout\" divided>退出登录</el-dropdown-item>\n            </el-dropdown-menu>\n          </el-dropdown>\n        </div>\n      </el-header>\n\n      <!-- Content -->\n      <el-main class=\"main-area\">\n        <router-view />\n      </el-main>\n    </el-container>\n  </el-container>\n</template>\n\n<script>\nexport default {\n  name: 'Layout',\n  data() {\n    const user = JSON.parse(localStorage.getItem('user') || '{}')\n    return {\n      userNickname: user.nickname || user.username || '用户',\n      userAvatar: user.avatar || '',\n      role: localStorage.getItem('role') || 'user',\n      noticeCount: 3,\n      collapsed: false,\n      darkMode: (localStorage.getItem('theme') || 'light') === 'dark'\n    }\n  },\n  computed: {\n    activeMenu() {\n      const path = this.$route.path\n      if (path.startsWith('/club')) return '/club'\n      if (path.startsWith('/venue')) return '/venue'\n      if (path.startsWith('/activity')) return '/activity'\n      if (path.startsWith('/facility')) return '/facility'\n      if (path.startsWith('/user')) return '/user'\n      if (path.startsWith('/profile')) return ''\n      return path\n    }\n  },\n  methods: {\n    toggleTheme() {\n      this.darkMode = !this.darkMode\n      const theme = this.darkMode ? 'dark' : 'light'\n      localStorage.setItem('theme', theme)\n      document.documentElement.setAttribute('data-theme', theme)\n    },\n    handleCommand(command) {\n      if (command === 'profile') {\n        this.$router.push('/profile')\n      } else if (command === 'toggleTheme') {\n        this.toggleTheme()\n      } else if (command === 'logout') {\n        localStorage.removeItem('user')\n        localStorage.removeItem('role')\n        this.$router.push('/login')\n        this.$message.success('已退出登录')\n      }\n    }\n  }\n}\n</script>\n\n<style scoped>\n/* === Sidebar === */\n.sidebar {\n  background: var(--sidebar-bg);\n  display: flex;\n  flex-direction: column;\n  transition: width 0.28s cubic-bezier(0.4, 0, 0.2, 1);\n  overflow: hidden;\n  border-right: 1px solid rgba(255,255,255,0.05);\n}\n\n.logo {\n  height: 48px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  gap: 8px;\n  border-bottom: 1px solid rgba(255,255,255,0.06);\n  flex-shrink: 0;\n}\n\n.logo-dot {\n  width: 8px;\n  height: 8px;\n  border-radius: 50%;\n  background: var(--brand-gradient);\n  box-shadow: 0 0 8px rgba(0,191,255,0.5);\n  flex-shrink: 0;\n}\n\n.logo-text {\n  color: rgba(255,255,255,0.85);\n  font-size: 14px;\n  font-weight: 600;\n  letter-spacing: 0.8px;\n  white-space: nowrap;\n}\n\n/* Menu */\n.side-menu {\n  border: none;\n  flex: 1;\n  overflow-y: auto;\n  overflow-x: hidden;\n}\n\n.side-menu >>> .el-menu-item,\n.side-menu >>> .el-submenu__title {\n  height: 42px;\n  line-height: 42px;\n  font-size: 13px;\n  margin: 2px 8px;\n  border-radius: 4px;\n  transition: all 0.2s;\n}\n\n.side-menu >>> .el-menu-item:hover,\n.side-menu >>> .el-submenu__title:hover {\n  background: var(--sidebar-hover) !important;\n}\n\n.side-menu >>> .el-menu-item.is-active {\n  background: linear-gradient(135deg, rgba(0,191,255,0.18), rgba(99,102,241,0.12)) !important;\n  color: var(--sidebar-text-active) !important;\n  box-shadow: inset 3px 0 0 var(--brand-start);\n}\n\n/* Collapsed: hide submenu indent */\n.side-menu.el-menu--collapse >>> .el-submenu__title span,\n.side-menu.el-menu--collapse >>> .el-submenu__title .el-submenu__icon-arrow {\n  display: none;\n}\n\n/* Move submenus slightly left when collapsed */\n.side-menu.el-menu--collapse >>> .el-menu-item {\n  padding-left: 20px !important;\n}\n\n/* Collapse Button */\n.collapse-btn {\n  height: 40px;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  color: rgba(255,255,255,0.35);\n  cursor: pointer;\n  border-top: 1px solid rgba(255,255,255,0.06);\n  transition: color 0.2s;\n  flex-shrink: 0;\n}\n\n.collapse-btn:hover {\n  color: rgba(255,255,255,0.75);\n  background: rgba(255,255,255,0.04);\n}\n\n.collapse-btn i {\n  font-size: 16px;\n}\n\n/* === Header === */\n.header-bar {\n  background: var(--header-bg);\n  display: flex;\n  align-items: center;\n  justify-content: space-between;\n  border-bottom: 1px solid var(--header-border);\n  padding: 0 20px;\n}\n\n.header-left {\n  font-size: 14px;\n  font-weight: 600;\n  color: var(--text-primary);\n  letter-spacing: 0.5px;\n}\n\n.header-right {\n  display: flex;\n  align-items: center;\n  gap: 18px;\n}\n\n/* Theme toggle */\n.theme-toggle {\n  font-size: 18px;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: color 0.2s;\n}\n\n.theme-toggle:hover {\n  color: var(--brand-start);\n}\n\n.notice-icon {\n  font-size: 18px;\n  color: var(--text-muted);\n  cursor: pointer;\n  transition: color 0.2s;\n}\n\n.notice-icon:hover {\n  color: var(--brand-start);\n}\n\n.user-dropdown {\n  display: flex;\n  align-items: center;\n  gap: 6px;\n  cursor: pointer;\n  padding: 3px 8px;\n  border-radius: 4px;\n  transition: background 0.2s;\n}\n\n.user-dropdown:hover {\n  background: rgba(0,0,0,0.04);\n}\n\n.username {\n  font-size: 13px;\n  color: var(--text-secondary);\n}\n\n.arrow-icon {\n  font-size: 12px;\n  color: var(--text-muted);\n}\n\n/* === Content === */\n.main-area {\n  background: var(--content-bg);\n  padding: 16px;\n  min-height: 0;\n}\n</style>\n"],"mappings":";;;;AA0GA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA,IAAAC,IAAA,GAAAC,IAAA,CAAAC,KAAA,CAAAC,YAAA,CAAAC,OAAA;IACA;MACAC,YAAA,EAAAL,IAAA,CAAAM,QAAA,IAAAN,IAAA,CAAAO,QAAA;MACAC,UAAA,EAAAR,IAAA,CAAAS,MAAA;MACAC,IAAA,EAAAP,YAAA,CAAAC,OAAA;MACAO,WAAA;MACAC,SAAA;MACAC,QAAA,GAAAV,YAAA,CAAAC,OAAA;IACA;EACA;EACAU,QAAA;IACAC,UAAA,WAAAA,WAAA;MACA,IAAAC,IAAA,QAAAC,MAAA,CAAAD,IAAA;MACA,IAAAA,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,IAAAF,IAAA,CAAAE,UAAA;MACA,OAAAF,IAAA;IACA;EACA;EACAG,OAAA;IACAC,WAAA,WAAAA,YAAA;MACA,KAAAP,QAAA,SAAAA,QAAA;MACA,IAAAQ,KAAA,QAAAR,QAAA;MACAV,YAAA,CAAAmB,OAAA,UAAAD,KAAA;MACAE,QAAA,CAAAC,eAAA,CAAAC,YAAA,eAAAJ,KAAA;IACA;IACAK,aAAA,WAAAA,cAAAC,OAAA;MACA,IAAAA,OAAA;QACA,KAAAC,OAAA,CAAAC,IAAA;MACA,WAAAF,OAAA;QACA,KAAAP,WAAA;MACA,WAAAO,OAAA;QACAxB,YAAA,CAAA2B,UAAA;QACA3B,YAAA,CAAA2B,UAAA;