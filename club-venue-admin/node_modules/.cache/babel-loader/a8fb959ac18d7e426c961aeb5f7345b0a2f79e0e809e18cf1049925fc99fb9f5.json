\"\n      :connection-distance=\"100\"\n      :line-opacity=\"0.1\"\n      :drift-speed=\"0.06\"\n      color1=\"#00f0ff\"\n      color2=\"#b847ff\"\n      :show-core=\"true\"\n      :core-particle-count=\"600\"\n      :core-radius=\"50\"\n      :core-size=\"5\"\n      core-color=\"#ffffff\"\n      :orbit-count=\"3\"\n      :orbit-radius=\"140\"\n      orbit-color=\"#00f0ff\"\n      :orbit-opacity=\"0.85\"\n      :orbit-speed=\"0.6\"\n      :show-beams=\"true\"\n      :beam-count=\"80\"\n      :beam-length=\"320\"\n      beam-color=\"#00f0ff\"\n      :show-pulse=\"true\"\n      pulse-color=\"#00f0ff\"\n      :pulse-max-radius=\"260\"\n      :show-wireframe=\"true\"\n      wireframe-color=\"#00e5ff\"\n      :wireframe-opacity=\"0.3\"\n    />\n\n    <!-- Login Card -->\n    <div class=\"login-card\">\n      <div class=\"login-header\">\n        <div class=\"card-dot\"></div>\n        <div class=\"card-title\">社团场地管理系统</div>\n        <div class=\"card-sub\">高校社团活动 · 场地调度一站管理</div>\n      </div>\n      <el-form ref=\"form\" :model=\"form\" :rules=\"rules\" @submit.native.prevent=\"submit\">\n        <el-form-item prop=\"username\">\n          <el-input v-model=\"form.username\" size=\"small\" placeholder=\"用户名\" prefix-icon=\"el-icon-user\" />\n        </el-form-item>\n        <el-form-item prop=\"password\">\n          <el-input v-model=\"form.password\" size=\"small\" type=\"password\" placeholder=\"密码\" prefix-icon=\"el-icon-lock\" show-password @keyup.enter.native=\"submit\" />\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" size=\"small\" class=\"login-btn\" @click=\"submit\" :loading=\"loading\">\n            登 录\n          </el-button>\n        </el-form-item>\n        <div class=\"link-register\">\n          没有账号？<router-link to=\"/register\">立即注册</router-link>\n        </div>\n      </el-form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport request from '@/api'\nimport ParticleBackground from '@/components/ParticleBackground.vue'\n\nexport default {\n  name: 'Login',\n  components: { ParticleBackground },\n  data() {\n    return {\n      form: { username: '', password: '' },\n      rules: {\n        username: [{ required: true, message: '请输入用户名', trigger: 'blur' }],\n        password: [{ required: true, message: '请输入密码', trigger: 'blur' }]\n      },\n      loading: false\n    }\n  },\n  methods: {\n    async submit() {\n      try {\n        await this.$refs.form.validate()\n      } catch { return }\n      this.loading = true\n      try {\n        const res = await request.post('/user/login', this.form)\n        if (res.code === 200) {\n          const userData = res.data\n          // Store token and user info via Vuex\n          this.$store.dispatch('login', {\n            token: userData.token,\n            userInfo: {\n              userId: userData.userId,\n              username: userData.username,\n              nickname: userData.nickname,\n              avatar: userData.avatar,\n              role: userData.role,\n              clubId: userData.clubId,\n              clubName: userData.clubName\n            }\n          })\n          this.$message.success('登录成功')\n          this.$router.push(this.$route.query.redirect || '/')\n        } else {\n          this.$message.error(res.message || '登录失败')\n        }\n      } catch {\n        this.$message.error('登录失败')\n      } finally {\n        this.loading = false\n      }\n    },\n  }\n}\n</script>\n\n<style scoped>\n.login-page {\n  height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(135deg, #020617 0%, #0a0f1e 50%, #050a18 100%);\n  position: relative;\n  overflow: hidden;\n}\n\n.login-card {\n  position: relative;\n  z-index: 1;\n  width: 380px;\n  background: rgba(255,255,255,0.06);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(255,255,255,0.08);\n  border-radius: 12px;\n  padding: 36px 32px 28px;\n  box-shadow: 0 20px 60px rgba(0,0,0,0.4);\n}\n\n.login-header {\n  text-align: center;\n  margin-bottom: 28px;\n}\n\n.card-dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #00BFFF, #6366F1);\n  margin: 0 auto 14px;\n  box-shadow: 0 0 16px rgba(0,191,255,0.5);\n}\n\n.card-title {\n  font-size: 22px;\n  font-weight: 700;\n  color: #e2e8f0;\n  letter-spacing: 1px;\n  margin-bottom: 6px;\n}\n\n.card-sub {\n  font-size: 12px;\n  color: rgba(148,163,184,0.7);\n  letter-spacing: 0.5px;\n}\n\n.login-card >>> .el-input__inner {\n  background: rgba(255,255,255,0.06) !important;\n  border: 1px solid rgba(255,255,255,0.1) !important;\n  color: #e2e8f0 !important;\n  border-radius: 6px;\n  height: 40px;\n}\n\n.login-card >>> .el-input__inner::placeholder {\n  color: rgba(148,163,184,0.5) !important;\n}\n\n.login-card >>> .el-input__inner:focus {\n  border-color: #00BFFF !important;\n  box-shadow: 0 0 0 2px rgba(0,191,255,0.15) !important;\n}\n\n.login-card >>> .el-input__prefix .el-icon-user,\n.login-card >>> .el-input__prefix .el-icon-lock {\n  color: rgba(148,163,184,0.5);\n}\n\n.login-btn {\n  width: 100%;\n  height: 40px;\n  font-size: 14px;\n  letter-spacing: 4px;\n  border-radius: 6px;\n}\n.link-register { text-align: center; font-size: 12px; color: rgba(148,163,184,0.6); margin-top: 4px }\n.link-register a { color: #00BFFF; text-decoration: none; transition: opacity .2s }\n.link-register a:hover { opacity: 0.8 }\n</style>\n"],"mappings":";;;AAkEA,OAAAA,OAAA;AACA,OAAAC,kBAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF,kBAAA,EAAAA;EAAA;EACAG,IAAA,WAAAA,KAAA;IACA;MACAC,IAAA;QAAAC,QAAA;QAAAC,QAAA;MAAA;MACAC,KAAA;QACAF,QAAA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAJ,QAAA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;MACAC,OAAA;IACA;EACA;EACAC,OAAA;IACAC,MAAA,WAAAA,OAAA;MAAA,IAAAC,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA,EAAAC,QAAA,EAAAC,EAAA,EAAAC,GAAA;QAAA,OAAAN,YAAA,GAAAO,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,C