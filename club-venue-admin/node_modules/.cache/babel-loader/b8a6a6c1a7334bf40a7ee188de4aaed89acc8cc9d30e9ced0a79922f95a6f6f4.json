         <i\n              :class=\"showPassword ? 'el-icon-view' : 'el-icon-lock'\"\n              class=\"eye-icon\"\n              @click=\"showPassword = !showPassword\"\n            ></i>\n          </div>\n        </el-form-item>\n        <el-form-item class=\"form-item\">\n          <button class=\"login-btn\" @click.prevent=\"handleLogin\">登录</button>\n        </el-form-item>\n      </el-form>\n    </div>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      loginForm: { username: '', password: '' },\n      showPassword: false,\n      loginRules: {\n        username: [{ required: true, message: '请输入用户名', trigger: 'blur' }],\n        password: [{ required: true, message: '请输入密码', trigger: 'blur' }]\n      }\n    }\n  },\n  methods: {\n    handleLogin() {\n      this.$refs.loginForm.validate(valid => {\n        if (valid) {\n          // TODO: 调用登录接口\n          this.$router.push('/')\n        }\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n* {\n  box-sizing: border-box;\n}\n\n.login-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100vh;\n  background: #2C3645;\n  padding: 0 40px;\n}\n\n.login-card {\n  width: 100%;\n  max-width: 460px;\n}\n\n.title {\n  text-align: center;\n  font-size: 26px;\n  font-weight: 700;\n  color: #FFFFFF;\n  margin: 0 0 56px 0;\n  letter-spacing: 3px;\n}\n\n.login-form {\n  width: 100%;\n}\n\n.form-item {\n  margin-bottom: 8px;\n}\n\n.input-wrapper {\n  position: relative;\n  display: flex;\n  align-items: center;\n  background: #3A455A;\n  border-radius: 24px;\n  height: 52px;\n  padding: 0 20px;\n}\n\n.input-icon {\n  color: rgba(255, 255, 255, 0.45);\n  font-size: 18px;\n  margin-right: 12px;\n  flex-shrink: 0;\n}\n\n.dark-input {\n  flex: 1;\n  height: 100%;\n  border: none;\n  outline: none;\n  background: transparent;\n  color: #FFFFFF;\n  font-size: 16px;\n}\n\n.dark-input::placeholder {\n  color: rgba(255, 255, 255, 0.35);\n}\n\n.eye-icon {\n  color: rgba(255, 255, 255, 0.45);\n  font-size: 18px;\n  cursor: pointer;\n  flex-shrink: 0;\n  margin-left: 12px;\n}\n\n.login-btn {\n  width: 100%;\n  height: 52px;\n  border: none;\n  outline: none;\n  background: #2196F3;\n  color: #FFFFFF;\n  font-size: 18px;\n  font-weight: 600;\n  border-radius: 24px;\n  cursor: pointer;\n  letter-spacing: 6px;\n  margin-top: 8px;\n  transition: background 0.2s;\n}\n\n.login-btn:hover {\n  background: #1E88E5;\n}\n\n.login-btn:active {\n  background: #1976D2;\n}\n</style>\n"],"mappings":";AAwCA;EACAA,IAAA;EACAC,IAAA,WAAAA,KAAA;IACA;MACAC,SAAA;QAAAC,QAAA;QAAAC,QAAA;MAAA;MACAC,YAAA;MACAC,UAAA;QACAH,QAAA;UAAAI,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAL,QAAA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;IACA;EACA;EACAC,OAAA;IACAC,WAAA,WAAAA,YAAA;MAAA,IAAAC,KAAA;MACA,KAAAC,KAAA,CAAAX,SAAA,CAAAY,QAAA,WAAAC,KAAA;QACA,IAAAA,KAAA;UACA;UACAH,KAAA,CAAAI,OAAA,CAAAC,IAAA;QACA;MACA;IACA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}