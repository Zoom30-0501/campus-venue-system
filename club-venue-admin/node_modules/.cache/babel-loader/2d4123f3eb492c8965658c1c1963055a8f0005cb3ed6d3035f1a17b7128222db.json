 class=\"card-dot\"></div>\n        <div class=\"card-title\">社团场地管理系统</div>\n        <div class=\"card-sub\">高校社团活动 · 场地调度一站管理</div>\n      </div>\n      <el-form ref=\"form\" :model=\"form\" :rules=\"rules\" @submit.native.prevent=\"submit\">\n        <el-form-item prop=\"username\">\n          <el-input v-model=\"form.username\" size=\"small\" placeholder=\"用户名\" prefix-icon=\"el-icon-user\" />\n        </el-form-item>\n        <el-form-item prop=\"password\">\n          <el-input v-model=\"form.password\" size=\"small\" type=\"password\" placeholder=\"密码\" prefix-icon=\"el-icon-lock\" show-password @keyup.enter.native=\"submit\" />\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" size=\"small\" class=\"login-btn\" @click=\"submit\" :loading=\"loading\">\n            登 录\n          </el-button>\n        </el-form-item>\n        <div class=\"link-register\">\n          没有账号？<router-link to=\"/register\">立即注册</router-link>\n        </div>\n      </el-form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport request from '@/api'\nimport ParticleBackground from '@/components/ParticleBackground.vue'\n\nexport default {\n  name: 'Login',\n  components: { ParticleBackground },\n  data() {\n    return {\n      form: { username: '', password: '' },\n      rules: {\n        username: [{ required: true, message: '请输入用户名', trigger: 'blur' }],\n        password: [{ required: true, message: '请输入密码', trigger: 'blur' }]\n      },\n      loading: false\n    }\n  },\n  methods: {\n    async submit() {\n      try {\n        await this.$refs.form.validate()\n      } catch { return }\n      this.loading = true\n      try {\n        const res = await request.post('/user/login', this.form)\n        if (res.code === 200) {\n          localStorage.setItem('user', JSON.stringify(res.data))\n          localStorage.setItem('role', res.data.role || 'user')\n          this.$message.success('登录成功')\n          this.$router.push(this.$route.query.redirect || '/')\n        } else {\n          this.$message.error(res.message || '登录失败')\n        }\n      } catch {\n        this.$message.error('登录失败')\n      } finally {\n        this.loading = false\n      }\n    },\n  }\n}\n</script>\n\n<style scoped>\n.login-page {\n  height: 100vh;\n  display: flex;\n  align-items: center;\n  justify-content: center;\n  background: linear-gradient(135deg, #0f172a 0%, #1e293b 50%, #172033 100%);\n  position: relative;\n  overflow: hidden;\n}\n\n.login-card {\n  position: relative;\n  z-index: 1;\n  width: 380px;\n  background: rgba(255,255,255,0.06);\n  backdrop-filter: blur(20px);\n  -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(255,255,255,0.08);\n  border-radius: 12px;\n  padding: 36px 32px 28px;\n  box-shadow: 0 20px 60px rgba(0,0,0,0.4);\n}\n\n.login-header {\n  text-align: center;\n  margin-bottom: 28px;\n}\n\n.card-dot {\n  width: 10px;\n  height: 10px;\n  border-radius: 50%;\n  background: linear-gradient(135deg, #00BFFF, #6366F1);\n  margin: 0 auto 14px;\n  box-shadow: 0 0 16px rgba(0,191,255,0.5);\n}\n\n.card-title {\n  font-size: 22px;\n  font-weight: 700;\n  color: #e2e8f0;\n  letter-spacing: 1px;\n  margin-bottom: 6px;\n}\n\n.card-sub {\n  font-size: 12px;\n  color: rgba(148,163,184,0.7);\n  letter-spacing: 0.5px;\n}\n\n.login-card >>> .el-input__inner {\n  background: rgba(255,255,255,0.06) !important;\n  border: 1px solid rgba(255,255,255,0.1) !important;\n  color: #e2e8f0 !important;\n  border-radius: 6px;\n  height: 40px;\n}\n\n.login-card >>> .el-input__inner::placeholder {\n  color: rgba(148,163,184,0.5) !important;\n}\n\n.login-card >>> .el-input__inner:focus {\n  border-color: #00BFFF !important;\n  box-shadow: 0 0 0 2px rgba(0,191,255,0.15) !important;\n}\n\n.login-card >>> .el-input__prefix .el-icon-user,\n.login-card >>> .el-input__prefix .el-icon-lock {\n  color: rgba(148,163,184,0.5);\n}\n\n.login-btn {\n  width: 100%;\n  height: 40px;\n  font-size: 14px;\n  letter-spacing: 4px;\n  border-radius: 6px;\n}\n.link-register { text-align: center; font-size: 12px; color: rgba(148,163,184,0.6); margin-top: 4px }\n.link-register a { color: #00BFFF; text-decoration: none; transition: opacity .2s }\n.link-register a:hover { opacity: 0.8 }\n</style>\n"],"mappings":";;;;;AAkDA,OAAAA,OAAA;AACA,OAAAC,kBAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF,kBAAA,EAAAA;EAAA;EACAG,IAAA,WAAAA,KAAA;IACA;MACAC,IAAA;QAAAC,QAAA;QAAAC,QAAA;MAAA;MACAC,KAAA;QACAF,QAAA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAJ,QAAA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;MACAC,OAAA;IACA;EACA;EACAC,OAAA;IACAC,MAAA,WAAAA,OAAA;MAAA,IAAAC,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA,EAAAC,EAAA,EAAAC,GAAA;QAAA,OAAAL,YAAA,GAAAM,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEAX,KAAA,CAAAY,KAAA,CAAAtB,IAAA,CAAAuB,QAAA;YAAA;cAAAJ,QAAA,CAAAE,CAAA;cAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAJ,EAAA,GAAAG,QAAA,CAAAK,CAAA;cAAA,OAAAL,QAAA,CAAAM,CAAA;YAAA;cAEAf,KAAA,CAAAH,OAAA;cAAAY,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OAEA1B,OAAA,CAAA+B,IAAA,gBAAAhB,KAAA,CAAAV,IAAA;YAAA;cAAAe,GAAA,GAAAI,QAAA,CAAAK,CAAA;cACA,IAAAT,GAAA,CAAAY,IAAA;gBACAC,YAAA,CAAAC,OAAA,SAAAC,IAAA,CAAAC,SAAA,CAAAhB,GAAA,CAAAhB,IAAA;gBACA6B,YAAA,CAAAC,OAAA,SAAAd,GAAA,CAAAhB,IAAA,CAAAiC,IAAA;gBACAtB,KAAA,CAAAuB,QAAA,CAAAC,OAAA;gBACAxB,KAAA,CAAAyB,OAAA,CAAAC,IAAA,CAAA1B,KAAA,CAAA2B,MAAA,CAAAC,KAAA,CAAAC,QAAA;cACA;gBACA7B,KAAA,CAAAuB,QAAA,CAAAO,KAAA,CAAAzB,GAAA,CAAAV,OAAA;cACA;cAAAc,QAAA,CAAAE,CAAA;cAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAH,GAAA,GAAAE,QAAA,CAAAK,CAAA;cAEAd,KAAA,CAAAuB,QAAA,CAAAO,KAAA;YAAA;cAAArB,QAAA,CAAAC,CAAA;cAEAV,KAAA,CAAAH,OAAA;cAAA,OAAAY,QAAA,CAAAsB,CAAA;YAAA;cAAA,OAAAtB,QAAA,CAAAM,CAAA;UAAA;QAAA,GAAAX,OAAA;MAAA;IAEA;EACA;AACA","ignoreList":[]},"metadata":{},"sourceType":"module","externalDependencies":[]}