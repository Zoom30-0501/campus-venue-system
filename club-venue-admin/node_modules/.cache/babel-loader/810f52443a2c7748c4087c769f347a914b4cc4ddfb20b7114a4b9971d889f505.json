\"500\"\n      :spread-y=\"500\"\n      :spread-z=\"350\"\n      :connection-distance=\"100\"\n      :line-opacity=\"0.08\"\n      :drift-speed=\"0.06\"\n      color1=\"#0ea5e9\"\n      color2=\"#f59e0b\"\n      :show-core=\"true\"\n      :core-particle-count=\"600\"\n      :core-radius=\"50\"\n      :core-size=\"5\"\n      core-color=\"#6366f1\"\n      :orbit-count=\"3\"\n      :orbit-radius=\"140\"\n      orbit-color=\"#0ea5e9\"\n      :orbit-opacity=\"0.6\"\n      :orbit-speed=\"0.6\"\n      :show-beams=\"true\"\n      :beam-count=\"80\"\n      :beam-length=\"320\"\n      beam-color=\"#10b981\"\n      :show-pulse=\"true\"\n      pulse-color=\"#6366f1\"\n      :pulse-max-radius=\"260\"\n      :show-wireframe=\"true\"\n      wireframe-color=\"#f59e0b\"\n      :wireframe-opacity=\"0.25\"\n    />\n\n    <!-- Login Card -->\n    <div class=\"login-card\">\n      <div class=\"login-header\">\n        <div class=\"card-dot\"></div>\n        <div class=\"card-title\">社团场地管理系统</div>\n        <div class=\"card-sub\">高校社团活动 · 场地调度一站管理</div>\n      </div>\n      <el-form ref=\"form\" :model=\"form\" :rules=\"rules\" @submit.native.prevent=\"submit\">\n        <el-form-item prop=\"username\">\n          <el-input v-model=\"form.username\" size=\"small\" placeholder=\"用户名\" prefix-icon=\"el-icon-user\" />\n        </el-form-item>\n        <el-form-item prop=\"password\">\n          <el-input v-model=\"form.password\" size=\"small\" type=\"password\" placeholder=\"密码\" prefix-icon=\"el-icon-lock\" show-password @keyup.enter.native=\"submit\" />\n        </el-form-item>\n        <el-form-item>\n          <el-button type=\"primary\" size=\"small\" class=\"login-btn\" @click=\"submit\" :loading=\"loading\">\n            登 录\n          </el-button>\n        </el-form-item>\n        <div class=\"link-register\">\n          没有账号？<router-link to=\"/register\">立即注册</router-link>\n        </div>\n      </el-form>\n    </div>\n  </div>\n</template>\n\n<script>\nimport request from '@/api'\nimport ParticleBackground from '@/components/ParticleBackground.vue'\n\nexport default {\n  name: 'Login',\n  components: { ParticleBackground },\n  data() {\n    return {\n      form: { username: '', password: '' },\n      rules: {\n        username: [{ required: true, message: '请输入用户名', trigger: 'blur' }],\n        password: [{ required: true, message: '请输入密码', trigger: 'blur' }]\n      },\n      loading: false\n    }\n  },\n  methods: {\n    async submit() {\n      try { await this.$refs.form.validate() } catch { return }\n      this.loading = true\n      try {\n        const res = await request.post('/user/login', this.form)\n        if (res.code === 200) {\n          const userData = res.data\n          this.$store.dispatch('login', {\n            token: userData.token,\n            userInfo: {\n              userId: userData.userId, username: userData.username,\n              nickname: userData.nickname, avatar: userData.avatar,\n              role: userData.role, clubId: userData.clubId, clubName: userData.clubName\n            }\n          })\n          this.$message.success('登录成功')\n          this.$router.push(this.$route.query.redirect || '/')\n        } else {\n          this.$message.error(res.message || '登录失败')\n        }\n      } catch { this.$message.error('登录失败') }\n      finally { this.loading = false }\n    },\n  }\n}\n</script>\n\n<style scoped>\n.login-page {\n  height: 100vh; display: flex; align-items: center; justify-content: center;\n  background: linear-gradient(135deg, #eef2ff 0%, #f0f9ff 50%, #f8fafc 100%);\n  position: relative; overflow: hidden;\n}\n.login-card {\n  position: relative; z-index: 1; width: 380px;\n  background: rgba(255,255,255,0.85);\n  backdrop-filter: blur(20px); -webkit-backdrop-filter: blur(20px);\n  border: 1px solid rgba(0,0,0,0.06);\n  border-radius: 12px; padding: 36px 32px 28px;\n  box-shadow: 0 20px 60px rgba(0,0,0,0.08);\n}\n.login-header { text-align: center; margin-bottom: 28px; }\n.card-dot {\n  width: 10px; height: 10px; border-radius: 50%;\n  background: linear-gradient(135deg, #0ea5e9, #6366f1);\n  margin: 0 auto 14px; box-shadow: 0 0 16px rgba(14,165,233,0.5);\n}\n.card-title { font-size: 22px; font-weight: 700; color: #1e293b; letter-spacing: 1px; margin-bottom: 6px; }\n.card-sub { font-size: 12px; color: #64748b; letter-spacing: 0.5px; }\n.login-card >>> .el-input__inner {\n  background: #f8fafc !important; border: 1px solid #e2e8f0 !important;\n  color: #1e293b !important; border-radius: 6px; height: 40px;\n}\n.login-card >>> .el-input__inner::placeholder { color: #94a3b8 !important; }\n.login-card >>> .el-input__inner:focus {\n  border-color: #6366f1 !important; box-shadow: 0 0 0 2px rgba(99,102,241,0.15) !important;\n}\n.login-card >>> .el-input__prefix .el-icon-user,\n.login-card >>> .el-input__prefix .el-icon-lock { color: #94a3b8; }\n.login-btn { width: 100%; height: 40px; font-size: 14px; letter-spacing: 4px; border-radius: 6px; }\n.link-register { text-align: center; font-size: 12px; color: #94a3b8; margin-top: 4px; }\n.link-register a { color: #6366f1; text-decoration: none; transition: opacity .2s; }\n.link-register a:hover { opacity: 0.8; }\n</style>\n"],"mappings":";;;AAkEA,OAAAA,OAAA;AACA,OAAAC,kBAAA;AAEA;EACAC,IAAA;EACAC,UAAA;IAAAF,kBAAA,EAAAA;EAAA;EACAG,IAAA,WAAAA,KAAA;IACA;MACAC,IAAA;QAAAC,QAAA;QAAAC,QAAA;MAAA;MACAC,KAAA;QACAF,QAAA;UAAAG,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;QACAJ,QAAA;UAAAE,QAAA;UAAAC,OAAA;UAAAC,OAAA;QAAA;MACA;MACAC,OAAA;IACA;EACA;EACAC,OAAA;IACAC,MAAA,WAAAA,OAAA;MAAA,IAAAC,KAAA;MAAA,OAAAC,iBAAA,cAAAC,YAAA,GAAAC,CAAA,UAAAC,QAAA;QAAA,IAAAC,GAAA,EAAAC,QAAA,EAAAC,EAAA,EAAAC,GAAA;QAAA,OAAAN,YAAA,GAAAO,CAAA,WAAAC,QAAA;UAAA,kBAAAA,QAAA,CAAAC,CAAA,GAAAD,QAAA,CAAAE,CAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAD,QAAA,CAAAE,CAAA;cAAA,OACAZ,KAAA,CAAAa,KAAA,CAAAvB,IAAA,CAAAwB,QAAA;YAAA;cAAAJ,QAAA,CAAAE,CAAA;cAAA;YAAA;cAAAF,QAAA,CAAAC,CAAA;cAAAJ,EAAA,GAAAG,QAAA,CAAAK,CAAA;cAAA,OAAAL,QAAA,CAAAM,CAAA;YAAA;cACAhB,KAAA,CAAAH,OAAA;cAAAa,QAAA,CAAAC,CAAA;cAAAD,