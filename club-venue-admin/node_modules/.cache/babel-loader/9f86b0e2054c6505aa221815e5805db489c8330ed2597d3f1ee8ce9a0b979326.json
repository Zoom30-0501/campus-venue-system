c/views/Login.vue"],"sourcesContent":["<template>\n  <div class=\"login-bg\">\n    <div class=\"login-container\">\n      <div class=\"login-card\">\n        <h1 class=\"title\">高校活动场地管理系统</h1>\n        <el-form ref=\"loginForm\" :model=\"loginForm\" :rules=\"loginRules\" class=\"login-form\">\n          <el-form-item prop=\"username\" class=\"form-item\">\n            <div class=\"input-wrapper\">\n              <i class=\"el-icon-user input-icon\"></i>\n              <input v-model=\"loginForm.username\" placeholder=\"用户名\" class=\"custom-input\" />\n            </div>\n          </el-form-item>\n          <el-form-item prop=\"password\" class=\"form-item\">\n            <div class=\"input-wrapper\">\n              <i class=\"el-icon-lock input-icon\"></i>\n              <input v-model=\"loginForm.password\" :type=\"showPassword ? 'text' : 'password'\" placeholder=\"密码\" class=\"custom-input\" />\n              <i class=\"el-icon-view eye-icon\" @click=\"showPassword = !showPassword\"></i>\n            </div>\n          </el-form-item>\n          <el-form-item class=\"form-item\">\n            <button class=\"login-btn\" @click.prevent=\"handleLogin\">登录</button>\n          </el-form-item>\n        </el-form>\n      </div>\n    </div>\n  </div>\n</template>\n\n<script>\nimport request from '@/api'\n\nexport default {\n  name: 'Login',\n  data() {\n    return {\n      loginForm: { username: '', password: '' },\n      showPassword: false,\n      loading: false,\n      loginRules: {\n        username: [{ required: true, message: '请输入用户名', trigger: 'blur' }],\n        password: [{ required: true, message: '请输入密码', trigger: 'blur' }]\n      }\n    }\n  },\n  methods: {\n    handleLogin() {\n      this.$refs.loginForm.validate(valid => {\n        if (!valid) return\n        this.loading = true\n        request.post('/user/login', this.loginForm)\n          .then(res => {\n            if (res.code === 200) {\n              localStorage.setItem('user', JSON.stringify(res.data))\n              localStorage.setItem('role', res.data.role || 'user')\n              this.$message.success('登录成功')\n              const redirect = this.$route.query.redirect || '/'\n              this.$router.push(redirect)\n            } else {\n              this.$message.error(res.message || '登录失败')\n            }\n          })\n          .catch(() => {\n            this.$message.error('网络错误，请检查后端是否启动')\n          })\n          .finally(() => { this.loading = false })\n      })\n    }\n  }\n}\n</script>\n\n<style scoped>\n* { box-sizing: border-box; }\n\n.login-bg {\n  position: fixed;\n  top: 0;\n  left: 0;\n  width: 100%;\n  height: 100%;\n  background: #F0F2F5;\n}\n\n.login-container {\n  display: flex;\n  justify-content: center;\n  align-items: center;\n  height: 100%;\n  padding: 0 40px;\n}\n\n.login-card {\n  width: 100%;\n  max-width: 420px;\n  background: #fff;\n  border: 1px solid #E4E7ED;\n  border-radius: 2px;\n  padding: 48px 40px 40px;\n}\n\n.title {\n  text-align: center;\n  font-size: 20px;\n  font-weight: 600;\n  color: #303133;\n  margin: 0 0 36px 0;\n  letter-spacing: 2px;\n}\n\n.login-form { width: 100%; }\n\n.form-item { margin-bottom: 12px; }\n\n.input-wrapper {\n  display: flex;\n  align-items: center;\n  border: 1px solid #DCDFE6;\n  border-radius: 2px;\n  height: 44px;\n  padding: 0 14px;\n  transition: border-color 0.2s;\n}\n\n.input-wrapper:focus-within {\n  border-color: #00BFFF;\n}\n\n.input-icon {\n  color: #C0C4CC;\n  font-size: 16px;\n  margin-right: 10px;\n  flex-shrink: 0;\n}\n\n.custom-input {\n  flex: 1;\n  height: 100%;\n  border: none;\n  outline: none;\n  background: transparent;\n  color: #303133;\n  font-size: 14px;\n}\n\n.custom-input::placeholder { color: #C0C4CC; }\n\n.eye-icon {\n  color: #C0C4CC;\n  font-size: 16px;\n  cursor: pointer;\n  flex-shrink: 0;\n  margin-left: 10px;\n}\n\n.eye-icon:hover { color: #909399; }\n\n.login-btn {\n  width: 100%;\n  height: 44px;\n  border: none;\n  outline: none;\n  backgroun